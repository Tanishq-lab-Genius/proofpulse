# OpenRouter provider key used by Bifrost (not the Bifrost virtual key).
OPENROUTER_API_KEY=replace-with-your-openrouter-key

# Virtual key ProofPulse uses when it calls the private Bifrost gateway.
# Choose a long private value; this value is also registered in Bifrost config.
BIFROST_API_KEY=replace-with-a-long-random-secret

# Tavily search key used server-side by ProofPulse.
TAVILY_API_KEY=replace-with-your-tavily-key

# Keep this identical to the model ID you have already selected in ProofPulse.
BIFROST_MODEL=openrouter/nvidia/nemotron-3.5-super-vl:free
