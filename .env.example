# Bifrost's OpenAI-compatible endpoint. Configure OpenRouter (or another provider) in Bifrost.
BIFROST_BASE_URL=http://localhost:8080/v1
BIFROST_API_KEY=local-development
BIFROST_MODEL=openrouter/free

# Keep this key private. Never commit .env.
TAVILY_API_KEY=tvly-your-key-here

# Optional HTTP bind address.
ADDR=:8000
